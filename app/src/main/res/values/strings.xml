    <string name="fx_monster_desc">Voix sombre d\'outre-tombe avec transposition grave profonde et saturation agressive.</string>

    <string name="fx_deep_title">Grave</string>
    <string name="fx_deep_desc">Voix profonde et chaleureuse avec amplification des basses fréquences.</string>

    <string name="fx_high_title">Aiguë</string>
    <string name="fx_high_desc">Voix festive hyper aiguë et ludique sans altération du tempo.</string>

    <string name="fx_echo_title">Écho</string>
    <string name="fx_echo_desc">Effet d\'écho spatialisé multi-taps et simulation de réverbération progressive.</string>

    <string name="fx_alien_title">Extraterrestre</string>
    <string name="fx_alien_desc">Modulation spatiale extraterrestre à double oscillateur et trémolo cosmique.</string>

    <string name="fx_cartoon_title">Dessin Animé</string>
    <string name="fx_cartoon_desc">Voix de personnage animé humoristique avec modulation de fréquence dynamique.</string>

    <string name="fx_elderly_title">Personne Âgée</string>
    <string name="fx_elderly_desc">Transformation stylisée avec tremblotement vocal naturel et bande passante filtrée.</string>

    <string name="fx_baby_title">Bébé</string>
    <string name="fx_baby_desc">Transformation mignonne très aiguë avec micro-modulations expressives.</string>

